# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Runtime output (never commit user data, screenshots or logs)
workspace/
data/
logs/
artifacts/*
!artifacts/acceptance_*.json
*.png
*.jpg
*.sqlite3
*.db

# Generated research data (regenerate from seeds; never commit)
research/**/out/

# Model weights
*.pt
*.pth
*.onnx
*.safetensors
*.bin

# uiautomation library log (may contain control names from the screen)
@AutomationLog.txt

# Secrets
.env
*.key

# Packaging output
build/
dist/
selftest.json

# Local tooling config (not part of ORION)
CLAUDE.md

# Agent trial traces (raw model replies; kept local)
research/agent_eval/*.json
