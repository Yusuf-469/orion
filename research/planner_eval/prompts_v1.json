    {"id": "p05", "text": "move report.txt to archive/report.txt", "expect": "ok"},
    {"id": "p06", "text": "put the contents of a.txt into b.txt", "expect": "ok"},
    {"id": "p07", "text": "read notes.txt", "expect": "ok"},
    {"id": "p08", "text": "list files", "expect": "ok"},
    {"id": "p09", "text": "open notepad", "expect": "ok"},
    {"id": "p10", "text": "create a file a.txt containing x then copy a.txt to b.txt then open calculator", "expect": "ok"},
    {"id": "p11", "text": "back up data.csv then delete the original", "expect": "ok"},
    {"id": "p12", "text": "delete old.txt", "expect": "ok"},
    {"id": "p13", "text": "create a file", "expect": "clarify"},
