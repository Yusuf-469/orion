    {"id": "p20", "text": "summarise the pdf in my downloads", "expect": "unsupported"},
    {"id": "p21", "text": "create a file ..\\escape.txt containing x", "expect": "invalid"},
    {"id": "p22", "text": "copy notes.txt to C:\\Windows\\notes.txt", "expect": "invalid"},
    {"id": "p23", "text": "create a file CON containing x", "expect": "invalid"},
    {"id": "p24", "text": "open powershell", "expect": "unsupported"}
  ]
